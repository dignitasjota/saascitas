generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum SubscriptionPlan {
  basic
  professional
  business
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  paused
}

enum AppointmentStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum NotificationType {
  email
  sms
  whatsapp
  push
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  bounced
}

enum UserRole {
  superadmin
  owner
  admin
  technician
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// ============================================
// TENANTS
// ============================================

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  address   String?
  city      String?  @db.VarChar(100)
  province  String?  @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(10)
  taxId     String?  @map("tax_id") @db.VarChar(20)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  timezone  String   @default("Europe/Madrid") @db.VarChar(50)
  locale    String   @default("es") @db.VarChar(10)

  // Subscription
  plan                   SubscriptionPlan   @default(basic)
  planStatus             SubscriptionStatus @default(trialing) @map("plan_status")
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz
  stripeCustomerId       String?            @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId   String?            @map("stripe_subscription_id") @db.VarChar(255)

  // Settings
  settings        Json @default("{}")
  bookingSettings Json @default("{\"minAdvanceHours\":2,\"maxAdvanceDays\":30,\"slotDurationMinutes\":60,\"bufferMinutes\":15,\"autoConfirm\":false,\"requirePhone\":true}") @map("booking_settings")

  // Plan limits
  maxEmployees Int  @default(1) @map("max_employees")
  maxCustomers Int? @map("max_customers")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  users              User[]
  employees          Employee[]
  services           Service[]
  customers          Customer[]
  appointments       Appointment[]
  notifications      Notification[]
  workingHours       WorkingHour[]
  scheduleExceptions ScheduleException[]
  employeeServices   EmployeeService[]
  bookingTokens      BookingToken[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]

  @@map("tenants")
}

// ============================================
// USERS
// ============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(technician)

  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String  @map("last_name") @db.VarChar(100)
  phone     String? @db.VarChar(20)
  avatarUrl String? @map("avatar_url") @db.VarChar(500)

  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz

  employeeId String? @map("employee_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ============================================
// EMPLOYEES
// ============================================

model Employee {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String  @map("last_name") @db.VarChar(100)
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(20)
  color     String  @default("#3B82F6") @db.VarChar(7)

  specialties String[] @default([])

  defaultLatitude    Decimal? @map("default_latitude") @db.Decimal(10, 8)
  defaultLongitude   Decimal? @map("default_longitude") @db.Decimal(11, 8)
  maxTravelRadiusKm  Int      @default(30) @map("max_travel_radius_km")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  users              User[]
  workingHours       WorkingHour[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  employeeServices   EmployeeService[]

  @@index([tenantId])
  @@map("employees")
}

// ============================================
// WORKING HOURS
// ============================================

model WorkingHour {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  dayOfWeek  DayOfWeek @map("day_of_week")
  startTime  String    @map("start_time") @db.VarChar(5) // "09:00"
  endTime    String    @map("end_time") @db.VarChar(5)   // "14:00"
  isActive   Boolean   @default(true) @map("is_active")

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, dayOfWeek, startTime])
  @@index([employeeId, dayOfWeek])
  @@map("working_hours")
}

// ============================================
// SCHEDULE EXCEPTIONS
// ============================================

model ScheduleException {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  date        DateTime @db.Date
  isAvailable Boolean  @default(false) @map("is_available")
  startTime   String?  @map("start_time") @db.VarChar(5)
  endTime     String?  @map("end_time") @db.VarChar(5)
  reason      String?  @db.VarChar(255)

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("schedule_exceptions")
}

// ============================================
// SERVICES
// ============================================

model Service {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  name            String  @db.VarChar(255)
  description     String?
  durationMinutes Int     @default(60) @map("duration_minutes")
  priceCents      Int?    @map("price_cents")
  color           String? @db.VarChar(7)

  isPublic  Boolean @default(true) @map("is_public")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  appointments     Appointment[]
  employeeServices EmployeeService[]

  @@index([tenantId])
  @@map("services")
}

// ============================================
// EMPLOYEE <-> SERVICE
// ============================================

model EmployeeService {
  employeeId String @map("employee_id") @db.Uuid
  serviceId  String @map("service_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@id([employeeId, serviceId])
  @@map("employee_services")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name") @db.VarChar(100)
  email     String? @db.VarChar(255)
  phone     String  @db.VarChar(20)

  address    String?
  city       String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(10)
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)

  notes String?
  tags  String[] @default([])

  totalAppointments  Int      @default(0) @map("total_appointments")
  totalSpentCents    BigInt   @default(0) @map("total_spent_cents")
  lastAppointmentAt  DateTime? @map("last_appointment_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  appointments  Appointment[]
  notifications Notification[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

// ============================================
// APPOINTMENTS
// ============================================

model Appointment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  serviceId  String? @map("service_id") @db.Uuid

  startsAt        DateTime @map("starts_at") @db.Timestamptz
  endsAt          DateTime @map("ends_at") @db.Timestamptz
  durationMinutes Int      @map("duration_minutes")

  status AppointmentStatus @default(pending)

  address    String?
  city       String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(10)
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)

  notes         String?
  customerNotes String? @map("customer_notes")
  priceCents    Int?    @map("price_cents")
  source        String  @default("manual") @db.VarChar(20)

  reminderSentAt     DateTime? @map("reminder_sent_at") @db.Timestamptz
  confirmationSentAt DateTime? @map("confirmation_sent_at") @db.Timestamptz
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancellationReason String?   @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  employee      Employee       @relation(fields: [employeeId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  notifications Notification[]
  bookingTokens BookingToken[]

  @@index([tenantId, employeeId, startsAt])
  @@index([tenantId, customerId, startsAt])
  @@index([tenantId, status, startsAt])
  // NOTE: a GiST exclusion constraint `appointments_no_overlap` prevents
  // overlapping active appointments for the same employee. Prisma cannot model
  // exclusion constraints, so it lives in the migration
  // `*_appointments_no_overlap_exclusion` and must not be dropped.
  @@map("appointments")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid

  type      NotificationType
  template  String            @db.VarChar(100)
  recipient String            @db.VarChar(255)
  subject   String?           @db.VarChar(500)
  body      String?

  status       NotificationStatus @default(pending)
  sentAt       DateTime?          @map("sent_at") @db.Timestamptz
  deliveredAt  DateTime?          @map("delivered_at") @db.Timestamptz
  failedAt     DateTime?          @map("failed_at") @db.Timestamptz
  errorMessage String?            @map("error_message")
  retryCount   Int                @default(0) @map("retry_count")
  nextRetryAt  DateTime?          @map("next_retry_at") @db.Timestamptz
  providerId   String?            @map("provider_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])

  @@index([appointmentId])
  @@index([status, nextRetryAt])
  @@map("notifications")
}

// ============================================
// BOOKING TOKENS
// ============================================

model BookingToken {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid

  token     String   @unique @db.VarChar(64)
  action    String   @db.VarChar(20) // 'confirm', 'cancel'
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([token])
  @@map("booking_tokens")
}

// ============================================
// REFRESH TOKENS
// ============================================

model RefreshToken {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  tokenHash String @map("token_hash") @db.VarChar(255)
  familyId  String @map("family_id") @db.Uuid

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address") @db.VarChar(45)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid

  action     String @db.VarChar(50)
  entityType String @map("entity_type") @db.VarChar(50)
  entityId   String? @map("entity_id") @db.Uuid

  changes   Json?
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================
// STRIPE EVENTS (webhook idempotency)
// ============================================

// Records processed Stripe webhook event ids so at-least-once redeliveries are
// not applied twice. Platform-global (no tenantId), so it is intentionally NOT
// tenant-scoped by the Prisma tenant-guard extension.
model StripeEvent {
  id          String   @id @db.VarChar(255) // Stripe event.id (evt_...)
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("stripe_events")
}
