# ── Database ──────────────────────────────────────────────────────────────────
# Development: uses docker-compose.yml postgres
# Production: change host to postgres (docker service name) or use external URL
DATABASE_URL="postgresql://saascitas:localdev123@localhost:5432/saascitas?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Development: Mailpit (docker-compose.yml)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@rutapro.es

# Production example (Resend):
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=resend
# MAIL_PASS=re_CHANGE_ME
# MAIL_FROM="RutaPro <noreply@rutapro.es>"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Stripe Price IDs — create in Stripe Dashboard > Products
STRIPE_PRICE_BASIC=price_CHANGE_ME
STRIPE_PRICE_PROFESSIONAL=price_CHANGE_ME
STRIPE_PRICE_BUSINESS=price_CHANGE_ME
